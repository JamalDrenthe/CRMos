rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function om te controleren of de gebruiker ingelogd is
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'info@jamaldrenthe.com' ||
        request.auth.token.email == 'info@crmos.one' ||
        request.auth.token.get('admin', false) == true
      );
    }

    // Gebruikersprofielen
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
    }

    // Organisaties en integraties / subcollecties
    match /organizations/{orgId} {
      allow read, write: if isAuthenticated();

      match /integrations/{integrationId} {
        allow read, write: if isAuthenticated();
      }

      match /{allSubcollections=**} {
        allow read, write: if isAuthenticated();
      }
    }

    // Contacten
    match /crm_contacts/{contactId} {
      allow read, write: if isAuthenticated();
    }

    // Bedrijven
    match /crm_companies/{companyId} {
      allow read, write: if isAuthenticated();
    }

    // Deals / Verkoopkansen
    match /crm_deals/{dealId} {
      allow read, write: if isAuthenticated();
    }

    // Activiteiten & taken
    match /crm_activities/{activityId} {
      allow read, write: if isAuthenticated();
    }

    // Recruitment: Kandidaten
    match /crm_candidates/{candidateId} {
      allow read, write: if isAuthenticated();
    }

    // Recruitment: Vacatures
    match /crm_jobs/{jobId} {
      allow read, write: if isAuthenticated();
    }

    // Contact Center: Belcampagnes
    match /crm_campaigns/{campaignId} {
      allow read, write: if isAuthenticated();
    }

    // Contact Center: Oproepen
    match /crm_calls/{callId} {
      allow read, write: if isAuthenticated();
    }

    // Sales: Offertes
    match /crm_quotes/{quoteId} {
      allow read, write: if isAuthenticated();
    }

    // Sales: Productencatalogus
    match /crm_products/{productId} {
      allow read, write: if isAuthenticated();
    }

    // Field Sales: Rayons & Gebieden
    match /crm_territories/{territoryId} {
      allow read, write: if isAuthenticated();
    }

    // Field Sales: Door-to-Door Pins
    match /crm_d2d_pins/{pinId} {
      allow read, write: if isAuthenticated();
    }

    // Integraties (HubSpot / Standalone)
    match /crm_integrations/{integrationId} {
      allow read, write: if isAuthenticated();
    }

    // VVC Ecosysteem Koppeling: Veilige sync-codes
    match /vvc_sync_codes/{codeId} {
      // Iedereen met de unieke code mag dát specifieke document ophalen via de API
      allow get: if true;
      allow list: if false; // Voorkomt dat iemand de hele lijst kan opvragen
      allow write: if isAuthenticated();
      allow create: if request.resource.data.keys().hasAll(['vvc_tag', 'email']);
    }

    // VVC API Registry: Unieke vvc_tag registraties voor VVC API & onboarding
    match /crm_vvc_registry/{vvcTag} {
      allow read: if true;
      allow write: if isAuthenticated();
      allow create: if request.resource.data.keys().hasAll(['vvc_tag', 'email']) &&
                       vvcTag.matches('^vvc-.*');
    }
  }
}
